# Yo! Payments API Configuration
# Get your API credentials from your Yo! Payments Merchant Account (https://payments.yo.co.ug)
YO_API_USERNAME=90000000000
YO_API_PASSWORD=your_yo_api_password_here

# Mode: 'production' or 'sandbox'
YO_MODE=production

# Server Port
PORT=3000

# Exchange Rate USD to UGX (used if donation is submitted in USD)
# Default rate: 3700 UGX per 1 USD
USD_TO_UGX_RATE=3700
